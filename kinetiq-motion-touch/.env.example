# KinetiQ Motion Touch Configuration
# Copy this file to .env and modify as needed

# URL of the KinetiQ Motion server
# Default: http://localhost:8080
# Examples:
#   KINETIQ_MOTION_URL=http://localhost:8080
#   KINETIQ_MOTION_URL=http://dwmp.local:8080
#   KINETIQ_MOTION_URL=http://192.168.1.100:8080
KINETIQ_MOTION_URL=http://localhost:8080
